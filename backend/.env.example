YOLO_MODEL_PATH=yolo11n.pt
YOLO_CONFIDENCE=0.35
YOLO_IOU=0.5
YOLO_IMGSZ=640
YOLO_MAX_DET=20
YOLO_CLASSES=
YOLO_TRACKER=bytetrack.yaml
USE_ML_ACTION=false
USE_ML_FALL=false
ACTION_MODEL_PATH=models/action_lstm.pt
FALL_MODEL_PATH=models/fall_xgb.json
ACTION_WINDOW_FRAMES=30
ACTION_STRIDE_FRAMES=5
KEYPOINT_VISIBILITY_THRESHOLD=0.5
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_ALERTS_TABLE=alerts
SUPABASE_REPORTS_TABLE=reports
ALERT_CHECK_INTERVAL_MS=5000
ABNORMAL_WINDOW_MS=3600000
ABNORMAL_MIN_SAMPLES=50
ABNORMAL_LYING_MS=60000
ABNORMAL_TRANSITION_THRESHOLD=20
ABNORMAL_DOMINANT_ACTION_RATIO=0.55
ABNORMAL_MIN_SCORE=0.65
ABNORMAL_SUPPRESSION_MS=300000
