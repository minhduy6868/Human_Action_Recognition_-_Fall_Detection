APP_NAME=video-ai-detect
APP_VERSION=0.1.0
ENVIRONMENT=local
RTSP_URL=
CAMERA_SOURCE=webcam
WEBCAM_INDEX=0
VIDEO_FILE_PATH=
LOOP_VIDEO_FILE=false
ENABLE_STREAM=true
FRAME_SKIP=1
HISTORY_SIZE=10000
WS_INTERVAL_MS=250
DEMO_MODE=false
