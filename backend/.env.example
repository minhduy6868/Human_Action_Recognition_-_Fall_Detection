APP_NAME=video-ai-detect
APP_VERSION=0.1.0
ENVIRONMENT=local
RTSP_URL=
CAMERA_SOURCE=webcam
WEBCAM_INDEX=0
VIDEO_FILE_PATH=
LOOP_VIDEO_FILE=false
ENABLE_STREAM=true
FRAME_SKIP=1
ADAPTIVE_FRAME_SKIP=true
TARGET_FPS=15
MAX_FRAME_SKIP=4
HISTORY_SIZE=10000
WS_INTERVAL_MS=250
DEMO_MODE=false
DEMO_INTERVAL_MS=500
YOLO_MODEL_PATH=yolo11n.pt
YOLO_POSE_MODEL_PATH=yolo11s-pose.pt
YOLO_CONFIDENCE=0.35
YOLO_POSE_CONFIDENCE=0.25
YOLO_IOU=0.5
YOLO_POSE_IOU=0.5
YOLO_IMGSZ=640
YOLO_MAX_DET=20
YOLO_CLASSES=
YOLO_TRACKER=botsort.yaml
CLOTHING_CACHE_FRAMES=30
FALL_RULE_CONSECUTIVE_FRAMES=3
POSE_FULL_FRAME_MATCH=true
POSE_MATCH_MIN_IOU=0.15
MJPEG_FPS=10
MJPEG_QUALITY=80
WEBCAM_SCAN_MAX=5
USE_ML_ACTION=false
USE_ML_FALL=false
# YOLO (Ultralytics) + optional LSTM: cpu | cuda | 0 | cuda:0 — use cuda for NVIDIA (e.g. RTX 3050 Ti)
MODEL_DEVICE=cpu
ACTION_MODEL_PATH=models/action_lstm.pt
FALL_MODEL_PATH=models/fall_xgb.json
ACTION_MODEL_INPUT_SIZE=99
ACTION_WINDOW_FRAMES=30
ACTION_STRIDE_FRAMES=5
ACTION_SMOOTH_WINDOW=12
ACTION_MIN_CONFIDENCE=0.4
KEYPOINT_VISIBILITY_THRESHOLD=0.5
FALL_DROP_THRESHOLD=0.18
FALL_ASPECT_THRESHOLD=1.2
FALL_VELOCITY_THRESHOLD=0.12
FALL_CONFIRM_MS=1500
FALL_CANDIDATE_WINDOW_MS=2500
DATABASE_URL=postgresql+psycopg://postgres:postgres123@localhost:5432/video-ai-detect
DATABASE_ENABLED=true
DB_AUTO_CREATE=true
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXP_MINUTES=15
REFRESH_TOKEN_EXP_DAYS=30
SEED_ADMIN=true
SEED_ADMIN_EMAIL=admin@local
SEED_ADMIN_PASSWORD=admin123
SEED_ADMIN_NAME=Admin
SEED_ADMIN_ROLE=admin
SEED_ADMIN_PLAN=vip
LOG_ENABLED=true
LOG_RETENTION_DAYS=30
LOG_CLEANUP_INTERVAL_MS=3600000
LOG_EVERY_N_FRAMES=1
LOG_SOURCE_ID=default
CHAT_HISTORY_ENABLED=true
CHAT_HISTORY_RETENTION_DAYS=30
CHAT_HISTORY_CLEANUP_INTERVAL_MS=21600000
ALERT_CHECK_INTERVAL_MS=5000
ABNORMAL_WINDOW_MS=3600000
ABNORMAL_MIN_SAMPLES=50
ABNORMAL_LYING_MS=60000
ABNORMAL_TRANSITION_THRESHOLD=20
ABNORMAL_DOMINANT_ACTION_RATIO=0.55
ABNORMAL_MIN_SCORE=0.65
ABNORMAL_SUPPRESSION_MS=300000
ENABLE_EVENT_REASONING=true
EVENT_CHECK_INTERVAL_MS=1000
LOITERING_WINDOW_MS=120000
LOITERING_MIN_IDLE_RATIO=0.7
LOITERING_SUPPRESSION_MS=300000
SUSPICIOUS_WINDOW_MS=60000
SUSPICIOUS_TRANSITION_THRESHOLD=12
SUSPICIOUS_SUPPRESSION_MS=120000
CROWD_MIN_PEOPLE=5
CROWD_MIN_DURATION_MS=10000
CROWD_SUPPRESSION_MS=120000
ABANDONED_OBJECT_STATIONARY_MS=60000
ABANDONED_OBJECT_MOVE_RATIO=0.15
ABANDONED_PERSON_DISTANCE_RATIO=2.5
ABANDONED_FORGET_MS=300000
ABANDONED_SUPPRESSION_MS=300000
